<?xml version="1.0" encoding="UTF-8"?>
<!--
  Resolves the runtime jars the migrations image copies into /liquibase/lib.
  Liquibase 5.x ships without JDBC drivers and there is no 5.x release of
  liquibase-azure-deps, so the SQL Server driver and the Azure Identity client
  used for Active Directory authentication are resolved here instead.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>uk.gov.defra.tracesx</groupId>
  <artifactId>soaprequest-configuration-liquibase-deps</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>

  <properties>
    <azure-identity.version>1.18.2</azure-identity.version>
    <mssql-jdbc.version>13.4.0.jre11</mssql-jdbc.version>
    <slf4j.version>1.7.36</slf4j.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.microsoft.sqlserver</groupId>
      <artifactId>mssql-jdbc</artifactId>
      <version>${mssql-jdbc.version}</version>
    </dependency>
    <dependency>
      <groupId>com.azure</groupId>
      <artifactId>azure-identity</artifactId>
      <version>${azure-identity.version}</version>
    </dependency>
    <!-- Binds the slf4j-api that azure-identity pulls in, as the 4.x image did. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-nop</artifactId>
      <version>${slf4j.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.8.1</version>
        <executions>
          <execution>
            <id>copy-runtime-jars</id>
            <phase>package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/lib</outputDirectory>
              <includeScope>runtime</includeScope>
              <!-- The image is linux/amd64 only. -->
              <excludeClassifiers>osx-x86_64,osx-aarch_64,windows-x86_64,linux-aarch_64</excludeClassifiers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
